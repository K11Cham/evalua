# Document Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# AI Services
GROQ_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_API_KEY=

# Translation
GOOGLE_TRANSLATE_API_KEY=

# Web Search
SERPAPI_KEY=

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production
