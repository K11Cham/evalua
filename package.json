{
  "name": "evalua",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Helps US school counselors evaluate international transcripts: extract, map to district curriculum, suggest credits with reasoning.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "fakes": "tsx tools/fakegen/generate.ts",
    "eval": "tsx tools/eval/run.ts",
    "kb:sql": "tsx tools/kb/build-sql.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "models": "tsx tools/models/fetch.ts",
    "eval:browser": "tsx tools/eval/browser.ts",
    "deploy": "npm run build && npm run kb:sql && wrangler d1 execute evalua-kb --remote --yes --file=migrations/0001_kb.sql && wrangler d1 execute evalua-kb --remote --yes --file=migrations/seed.sql && wrangler pages deploy dist --project-name evalua --branch main --commit-dirty=true",
    "eval:split": "tsx tools/eval/split.ts",
    "eval:a11y": "tsx tools/eval/a11y.ts",
    "eval:model": "tsx tools/eval/model.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/besley": "^5.3.0",
    "heic-to": "^1.6.7",
    "idb": "^8.0.4",
    "mammoth": "^1.13.0",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.5.438",
    "ppu-paddle-ocr": "^6.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "docx": "^9.15.4",
    "onnxruntime-node": "^1.31.1",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true,
    "tesseract.js": false,
    "onnxruntime-node@1.31.1": true
  }
}
